local function MakeSlider(parent, text, settingKey, minV, maxV, step, suffix, onChange)
	step = step or 1
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, 0, 0, 48)
	f.BackgroundColor3 = BG_ELEM
	f.BackgroundTransparency = 0.3

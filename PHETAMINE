-- Exposed to the GUI toggle; internals live in the do-block below so
-- their registers are freed.
local hookFallDamageFolder
do
	local hookedFolders = setmetatable({}, { __mode = "k" })

	-- Game effect scripts to disable (STALKER): the gas-mask visor/breathing
	-- and film-grain effects. Set Disabled = true on LocalScript/Script.
	local DISABLE_SCRIPTS = {
		GasMaskVisor = true,
		GasMaskBreathing = true,
		GrainClient = true,
	}

	-- Called on every descendant in StarterPlayer/PlayerScripts/character now
	-- and on every future DescendantAdded. Destroys FallDamage (toggle-gated)
	-- and disables the named effect scripts.
	local function controlGameScript(inst)
		if not inst then return end

		if inst.Name == "FallDamage" then
			if not Settings.RemoveFallDamage then return end
			local ok, isScript = pcall(function()
				return inst:IsA("LocalScript") or inst:IsA("Script")
			end)
			if ok and isScript then
				pcall(function()
					inst.Disabled = true
					inst:Destroy()
				end)
			end
			return
		end

		if DISABLE_SCRIPTS[inst.Name] then
			local ok, isScript = pcall(function()
				return inst:IsA("LocalScript") or inst:IsA("Script")
			end)
			if ok and isScript then
				pcall(function() inst.Disabled = true end)
			end
		end
	end

	-- Handle everything present now, then keep handling anything the game
	-- adds later (descendant signals cover re-parented/recreated scripts).
	hookFallDamageFolder = function(folder)
		if not folder or hookedFolders[folder] then return end
		hookedFolders[folder] = true
		for _, child in ipairs(folder:GetDescendants()) do
			controlGameScript(child)
		end
		folder.DescendantAdded:Connect(controlGameScript)
	end
end

-- FallDamage and the gas-mask/grain scripts live in StarterPlayer /
-- StarterPlayerScripts (and get copied into PlayerScripts); also sweep the
-- character, where some games inject them.
task.spawn(function()
	pcall(function() hookFallDamageFolder(StarterPlayer) end)
	local spScripts = StarterPlayer:FindFirstChild("StarterPlayerScripts")
	if spScripts then pcall(function() hookFallDamageFolder(spScripts) end) end
	local spCharScripts = StarterPlayer:FindFirstChild("StarterCharacterScripts")
	if spCharScripts then pcall(function() hookFallDamageFolder(spCharScripts) end) end
	local pScripts = LocalPlayer:WaitForChild("PlayerScripts", 10)
	if pScripts then pcall(function() hookFallDamageFolder(pScripts) end) end
	if LocalPlayer.Character then pcall(function() hookFallDamageFolder(LocalPlayer.Character) end) end
	Runtime:Connect(LocalPlayer.CharacterAdded, function(char)
		pcall(function() hookFallDamageFolder(char) end)
	end)
end)


-- Aimbot / aimlock (Hostile NPCs & Players)
----------------------------------------------------
local aimlockKeyHeld = false
local selectedAimlock = 1
local currentAimTarget, currentAimTarget2 = nil, nil

local aimRayParams = RaycastParams.new()
aimRayParams.FilterType = Enum.RaycastFilterType.Exclude
local aimIgnore = {}

-- Find an aimable BasePart on a character model. NPC kits don't always name
-- the head "Head" (and the configured part may be missing), so this falls
-- back through the model hierarchy instead of returning nil.
local function findAimPart(cache, model, partName)
	if not cache then return nil end

	if partName and cache.parts and cache.parts[partName] then
		return cache.parts[partName]
	end

	if model then
		if partName then
			local named = model:FindFirstChild(partName, true)
			if named and named:IsA("BasePart") then return named end
		end
		local head = model:FindFirstChild("Head", true)
		if head and head:IsA("BasePart") then return head end
	end

	if cache.head and cache.head:IsA("BasePart") and cache.head.Parent then
		return cache.head
	end
	if cache.hrp and cache.hrp:IsA("BasePart") and cache.hrp.Parent then
		return cache.hrp
	end
	if model then
		local anyPart = model:FindFirstChildWhichIsA("BasePart", true)
		if anyPart then return anyPart end
	end
	return nil
end

local function getNPCAimPart(cache, partName)
	return findAimPart(cache, cache and cache.char or cache and cache.model, partName)
end

local function canSee(part, targetRoot, wallCheck)
	if not wallCheck then return true end
	if not part then return false end
	aimIgnore[1] = LocalPlayer.Character or Workspace
	aimIgnore[2] = targetRoot or part.Parent
	aimRayParams.FilterDescendantsInstances = aimIgnore
	local origin = Camera.CFrame.Position
	local hit = Workspace:Raycast(origin, part.Position - origin, aimRayParams)
	return hit == nil
end

local function scoreTargetPart(part, maxDistance, fov, targetClosest)
	local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local localPos = localRoot and localRoot.Position or Camera.CFrame.Position
	local dist = (localPos - part.Position).Magnitude
	if maxDistance > 0 and dist > maxDistance then return nil end
	local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
	if not onScreen or screenPos.Z <= 0 then return nil end
	local center = Camera.ViewportSize / 2
	local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
	if fov > 0 and screenDist > fov then return nil end
	return targetClosest and dist or screenDist, dist
end

local function scoreNPC(model, partName, wallCheck, maxDistance, fov, targetClosest)
	if not model or not model.Parent then return nil end
	local cache = HostileNPCCache[model]
	if not cache or not isAlive(cache, model) then return nil end
	local part = getNPCAimPart(cache, partName)
	if not part or not canSee(part, model, wallCheck) then return nil end
	local score, dist = scoreTargetPart(part, maxDistance, fov, targetClosest)
	if not score then return nil end
	return part, score, dist
end

local function scorePlayerTarget(plr, partName, wallCheck, maxDistance, fov, targetClosest)
	if not plr or not plr.Parent or plr == LocalPlayer then return nil end
	if Settings.PlayerTeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then return nil end
	local cache = getPlayerCache(plr)
	if not isPlayerAlive(cache) then return nil end
	local part = getNPCAimPart(cache, partName)
	if not part or not canSee(part, cache.char, wallCheck) then return nil end
	local score, dist = scoreTargetPart(part, maxDistance, fov, targetClosest)
	if not score then return nil end
	return part, score, dist
end

local function getBestAimTarget(current, targetNPCs, targetPlayers, partName, wallCheck, maxDistance, fov, targetClosest)
	if current then
		if typeof(current) == "Instance" and current:IsA("Player") then
			if targetPlayers then
				local part, score = scorePlayerTarget(current, partName, wallCheck, maxDistance, fov, targetClosest)
				if part then return current, part end
			end
		else
			if targetNPCs then
				local part, score = scoreNPC(current, partName, wallCheck, maxDistance, fov, targetClosest)
				if part then return current, part end
			end
		end
	end

	local bestObj, bestPart, bestScore

	if targetNPCs then
		for _, model in ipairs(HostileNPCList) do
			local part, score = scoreNPC(model, partName, wallCheck, maxDistance, fov, targetClosest)
			if part and (not bestScore or score < bestScore) then
				bestObj, bestPart, bestScore = model, part, score
			end
		end
	end

	if targetPlayers then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local part, score = scorePlayerTarget(plr, partName, wallCheck, maxDistance, fov, targetClosest)
				if part and (not bestScore or score < bestScore) then
					bestObj, bestPart, bestScore = plr, part, score
				end
			end
		end
	end

	return bestObj, bestPart
end

local function aimAt(part, smoothness, prediction, dt)
	local position = part.Position
	if prediction and prediction > 0 then position = position + (part.AssemblyLinearVelocity * prediction) end
	local camPos = Camera.CFrame.Position
	local goal = CFrame.lookAt(camPos, position)
	if not smoothness or smoothness <= 1 then
		Camera.CFrame = goal
	else
		Camera.CFrame = Camera.CFrame:Lerp(goal, math.clamp(dt * (20 / smoothness), 0.05, 1))
	end
end

local function setAimlockEnabled(which, enabled)
	selectedAimlock = which
	if which == 1 then
		Settings.AimlockEnabled = enabled
		if enabled then Settings.Aimlock2Enabled = false end
	else
		Settings.Aimlock2Enabled = enabled
		if enabled then Settings.AimlockEnabled = false end
	end
	currentAimTarget = nil
	currentAimTarget2 = nil
	if not enabled then aimlockKeyHeld = false end
	refreshToggle("AimlockEnabled")
	refreshToggle("Aimlock2Enabled")
end

Runtime:Connect(UserInputService.InputBegan, function(input, gpe)

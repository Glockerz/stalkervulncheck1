	warn("[PHETAMINE] Drawing API not found; ESP/FOV drawings need an executor with Drawing support.")
end

local DRAW_FONT = (Drawing and Drawing.Fonts and Drawing.Fonts.UI) or 2
local MAX_TOTAL_DRAWINGS = 256
local activeDrawingCount = 0

local function newDrawing(class, props)
	local realObj = nil
	if hasDrawing and activeDrawingCount < MAX_TOTAL_DRAWINGS then
		local ok, inst = pcall(function()
			return Drawing.new(class)
		end)
		if ok and inst then
			realObj = inst
			activeDrawingCount = activeDrawingCount + 1
		end
	end

	local state = {
		Visible = false,
		Color = Color3.new(1, 1, 1),
		Transparency = 1,
		Thickness = 1,
		From = Vector2.zero,
		To = Vector2.zero,
		Position = Vector2.zero,
		Size = Vector2.zero,
		Text = "",
		Center = false,
		Outline = false,
		Filled = false,
		Radius = 0,
		NumSides = 0,
		Font = DRAW_FONT,
	}

	for k, v in pairs(props or {}) do
		state[k] = v
		if realObj then
			pcall(function() realObj[k] = v end)
		end
	end

	local proxy = {}
	proxy.__real = realObj

	function proxy:Remove()
		if realObj then
			pcall(function()
				realObj.Visible = false
				realObj:Remove()
			end)
			realObj = nil
			activeDrawingCount = math.max(0, activeDrawingCount - 1)
		end
	end

	function proxy:Destroy()
		self:Remove()
	end

	local mt = {
		__index = function(_, k)
			if realObj then
				local ok, val = pcall(function() return realObj[k] end)
				if ok and val ~= nil then return val end
			end
			return state[k]
		end,
		__newindex = function(_, k, v)
			state[k] = v
			if realObj then
				pcall(function() realObj[k] = v end)
			end
		end,
	}

	return setmetatable(proxy, mt)
end

local function removeDrawing(d)
	if d and d.Remove then
		pcall(function()
			d:Remove()
		end)
	end
end


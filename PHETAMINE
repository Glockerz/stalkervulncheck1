-- Window drag / minimize / close / menu key
----------------------------------------------------
do
	-- Single table instead of three upvalues: keeps the chunk's active-local
	-- count under Luau's 200-register compiler limit.
	local dragState = { dragging = false, start = nil, framePos = nil }
	TitleBar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragState.dragging = true
			dragState.start = i.Position
			dragState.framePos = MainFrame.Position
		end
	end)
	Runtime:Connect(UserInputService.InputChanged, function(i)
		if dragState.dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragState.start
			local p = dragState.framePos
			MainFrame.Position = UDim2.new(p.X.Scale, p.X.Offset + d.X, p.Y.Scale, p.Y.Offset + d.Y)
		end
	end)
	Runtime:Connect(UserInputService.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragState.dragging = false end
	end)
end

do
	local minimized = false
	local savedHeight = MainFrame.Size.Y.Offset
	MinimizeBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		ContentArea.Visible = not minimized

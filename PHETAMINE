	if cache.descAdded then pcall(function() cache.descAdded:Disconnect() end); cache.descAdded = nil end
	if cache.descRemoving then pcall(function() cache.descRemoving:Disconnect() end); cache.descRemoving = nil end
	if cache.ancestryConn then pcall(function() cache.ancestryConn:Disconnect() end); cache.ancestryConn = nil end
end

local function rebuildNPCCache(cache, model)
	cache.model = model
	cache.char = model
	cache.hrp = nil
	cache.head = nil
	cache.hum = nil
	cache.parts = cache.parts or {}
	table.clear(cache.parts)

	if not model or not model.Parent then return end

	for _, inst in ipairs(model:GetDescendants()) do
		if inst:IsA("BasePart") then
			cache.parts[inst.Name] = inst
			if inst.Name == "HumanoidRootPart" then
				cache.hrp = inst
			elseif inst.Name == "Head" then
				cache.head = inst
			end
		elseif inst:IsA("Humanoid") then
			cache.hum = inst
		end
	end

	cache.hrp = cache.hrp
		or (model:IsA("Model") and model.PrimaryPart)
		or model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("LowerTorso")
		or model:FindFirstChildWhichIsA("BasePart", true)
		or (model:IsA("BasePart") and model)

	cache.head = cache.head
		or model:FindFirstChild("Head")

	cache.hum = cache.hum
		or model:FindFirstChildWhichIsA("Humanoid")
end

local function isAlive(cache, model)
	if not cache then return false end
	if model and not model.Parent then return false end
	local hrp = cache.hrp
	if not hrp or not hrp.Parent then return false end

	local hum = cache.hum
	if hum and hum.Parent then
		-- Only treat as dead when a humanoid clearly reports death; some NPC
		-- kits keep a Humanoid at 0 Health while the target is still shootable,
		-- so require an explicit Dead state (or >0 max health with 0 health).
		if hum:GetState() == Enum.HumanoidStateType.Dead then
			return false
		end
		if hum.Health <= 0 and hum.MaxHealth > 0 then
			return false
		end
	end

	if model then
		local attrHp = model:GetAttribute("Health")
		if type(attrHp) == "number" and attrHp < 0 then
			return false
		end
		local valHp = model:FindFirstChild("Health")
		if valHp and (valHp:IsA("NumberValue") or valHp:IsA("IntValue")) and valHp.Value < 0 then
			return false
		end
	end

	return true
end

local function untrackNPC(model)
	if not model then return end
	local cache = HostileNPCCache[model]
	if cache then
		disconnectNPCCache(cache)
		HostileNPCCache[model] = nil
	end

	for i = #HostileNPCList, 1, -1 do
		if HostileNPCList[i] == model then
			table.remove(HostileNPCList, i)
		end
	end
end

local function trackNPC(model)
	if not model then return end
	if not (model:IsA("Model") or model:IsA("BasePart")) then return end
	if not model.Parent then return end
	if HostileNPCCache[model] then return end

	local cache = { parts = {} }
	HostileNPCCache[model] = cache
	rebuildNPCCache(cache, model)

	local function refresh()
		task.defer(function()
			if Runtime.alive and HostileNPCCache[model] == cache then
				rebuildNPCCache(cache, model)
			end
		end)
	end
	cache.descAdded = model.DescendantAdded:Connect(refresh)
	cache.descRemoving = model.DescendantRemoving:Connect(refresh)

	cache.ancestryConn = model.AncestryChanged:Connect(function(_, parent)
		if not parent or not model:IsDescendantOf(Workspace) then
			untrackNPC(model)
		end
	end)

	table.insert(HostileNPCList, model)
end

local function disconnectHostileState()
	for _, conn in ipairs(HostileFolderState.conns) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(HostileFolderState.conns)
	HostileFolderState.playerCharacters = nil
	HostileFolderState.hostileFolder = nil
end

-- Reconcile recursively, including pre-existing nested folders and streamed rigs.
-- Stop at each rig so accessories/limbs are not registered as separate NPCs.
local function scanHostileFolder(folder, seen)
	for _, child in ipairs(folder:GetChildren()) do
		local rig = child:IsA("Model") and (
			child:FindFirstChildWhichIsA("Humanoid")
			or child:FindFirstChild("HumanoidRootPart")
			or child:FindFirstChild("Head")
			or child.PrimaryPart)
		if rig or child:IsA("BasePart") then
			seen[child] = true
			trackNPC(child)
			rebuildNPCCache(HostileNPCCache[child], child)
		elseif child:IsA("Folder") or child:IsA("Model") then
			scanHostileFolder(child, seen)
		end
	end
end

local function updateHostileTracking()
	if not Runtime.alive then return end
	local pc = Workspace:FindFirstChild("PlayerCharacters")
	local hf = pc and pc:FindFirstChild("HostileNPCs")
	HostileFolderState.playerCharacters = pc
	HostileFolderState.hostileFolder = hf
	local seen = {}
	if hf then scanHostileFolder(hf, seen) end
	for i = #HostileNPCList, 1, -1 do
		local model = HostileNPCList[i]
		if not seen[model] then untrackNPC(model) end
	end
end

updateHostileTracking()

Runtime:Connect(Workspace.ChildAdded, function(child)
	if child.Name == "PlayerCharacters" then
		task.defer(updateHostileTracking)
	end
end)

Runtime:Connect(Workspace.DescendantAdded, function(desc)
	if desc.Name == "HostileNPCs" or desc.Name == "PlayerCharacters" then
		task.defer(updateHostileTracking)
	end
end)

----------------------------------------------------
-- Hostile NPC Highlighting (Chams)
----------------------------------------------------
-- NPC chams use Roblox Highlight instances (the same mechanism the player
-- chams use) keyed per-model, updated every ESP frame. The 2D Drawing pool
-- only handles boxes/names/tracers, so this is what actually makes NPCs
-- glow through walls.
local updateNPCHighlights
do
	local NPCHighlights = setmetatable({}, { __mode = "k" })
	local chamsParent = nil

	local function getChamsParent()
		if chamsParent and chamsParent.Parent then return chamsParent end
		-- Highlight instances must live in the rendered world, not CoreGui.
		chamsParent = Instance.new("Folder")
		chamsParent.Name = "PHETAMINE_NPCChams"
		chamsParent.Parent = Workspace
		return chamsParent
	end
	Runtime:OnTeardown(function()
		if chamsParent then chamsParent:Destroy(); chamsParent = nil end
	end)

	local function getHighlight(model)
		local hl = NPCHighlights[model]
		if hl and hl.Parent then return hl end
		local parent = getChamsParent()
		if not parent then return nil end
		hl = Instance.new("Highlight")
		hl.Name = "PHETAMINE_NPCHL"
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Enabled = false
		hl.Adornee = model
		hl.Parent = parent
		NPCHighlights[model] = hl
		return hl
	end

	updateNPCHighlights = function()
		local active = Settings.Enabled and Settings.HighlightNPCs
		local localChar = LocalPlayer.Character
		local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
		local localPos = localHrp and localHrp.Position or (Camera and Camera.CFrame.Position) or ZERO3
		local hlColor = Settings.RainbowColor and currentColor() or Settings.PlayerHighlightColor

		local seen = {}
		if active then
			for _, model in ipairs(HostileNPCList) do
				seen[model] = true
				local cache = HostileNPCCache[model]
				local hl = getHighlight(model)
				local show = cache and isAlive(cache, model) and hl ~= nil

				if show and Settings.MaxDistance > 0 and cache.hrp then
					local dist = (localPos - cache.hrp.Position).Magnitude
					if dist > Settings.MaxDistance then show = false end
				end

				if show then
					hl.Adornee = model
					hl.FillColor = hlColor
					hl.OutlineColor = Color3.fromRGB(255, 255, 255)
					hl.FillTransparency = Settings.PlayerHighlightFillTransparency
					hl.OutlineTransparency = Settings.PlayerHighlightOutlineTransparency
					hl.Enabled = true
				elseif hl then
					hl.Enabled = false
					hl.Adornee = nil
				end
			end
		end

		-- Prune highlights for NPCs that disappeared / lost tracking.
		for model, hl in pairs(NPCHighlights) do
			if not seen[model] or not (active and model and model.Parent) then
				pcall(function() hl:Destroy() end)
				NPCHighlights[model] = nil
			end
		end
	end
end

----------------------------------------------------
-- Hostile NPC ESP Drawing Pool (Budget-Capped)
----------------------------------------------------
local MAX_ESP_POOL_SIZE = 32
local MAX_SKELETON_SLOTS = 4
local ESPPool = {}

local function hideSlot(slot)
	if not slot then return end
	if slot.box then slot.box.Visible = false end
	if slot.boxOutline then slot.boxOutline.Visible = false end
	if slot.name then slot.name.Visible = false end
	if slot.dist then slot.dist.Visible = false end
	if slot.tracer then slot.tracer.Visible = false end
	if slot.skeleton then
		for _, line in ipairs(slot.skeleton) do
			line.Visible = false
		end
	end
end

local function hideAllSlots()
	for _, slot in ipairs(ESPPool) do
		hideSlot(slot)
	end
end

local function initESPPool()
	for i = 1, MAX_ESP_POOL_SIZE do
		local slot = {
			box = newDrawing("Square", { Visible = false, Filled = false, Thickness = 1.5 }),
			boxOutline = newDrawing("Square", { Visible = false, Filled = false, Thickness = 3, Color = Color3.new(0, 0, 0) }),
			name = newDrawing("Text", { Visible = false, Center = true, Outline = true, Size = Settings.TextSize, Font = DRAW_FONT }),
			dist = newDrawing("Text", { Visible = false, Center = true, Outline = true, Size = Settings.TextSize, Font = DRAW_FONT }),
			tracer = newDrawing("Line", { Visible = false, Thickness = 1 }),
			skeleton = nil,
		}
		if i <= MAX_SKELETON_SLOTS then
			slot.skeleton = {}
			for b = 1, math.max(#R15_BONES, #R6_BONES) do
				slot.skeleton[b] = newDrawing("Line", { Visible = false, Thickness = 1.5 })
			end
		end
		ESPPool[i] = slot
	end
end

initESPPool()

local espAccum = 0
Runtime:Connect(RunService.RenderStepped, function(dt)
	espAccum = espAccum + dt
	if espAccum < ESP_UPDATE_RATE then return end
	espAccum = 0

	Camera = Workspace.CurrentCamera
	if not Camera then return end
	local camPos = Camera.CFrame.Position
	local localChar = LocalPlayer.Character
	local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
	local localPos = localRoot and localRoot.Position or camPos
	local color = currentColor()

	-- Update Player & NPC Highlights continuously
	updatePlayerHighlights()
	updateNPCHighlights()

	if not Settings.Enabled then
		hideAllSlots()
		return
	end

	local renderCandidates = {}
	for _, model in ipairs(HostileNPCList) do
		local cache = HostileNPCCache[model]
		if cache and isAlive(cache, model) and cache.hrp then
			local hrpPos = cache.hrp.Position
			local dist = (localPos - hrpPos).Magnitude
			if Settings.MaxDistance == 0 or dist <= Settings.MaxDistance then
				local rootPos, onScreen = Camera:WorldToViewportPoint(hrpPos)
				if onScreen and rootPos.Z > 0 then
					table.insert(renderCandidates, {
						model = model,
						cache = cache,
						dist = dist,
						rootPos = rootPos,
					})
				end
			end
		end
	end

	table.sort(renderCandidates, function(a, b)
		return a.dist < b.dist
	end)

	for i = 1, MAX_ESP_POOL_SIZE do
		local slot = ESPPool[i]
		local cand = renderCandidates[i]
		if cand then
			local model = cand.model
			local cache = cand.cache
			local hrp = cache.hrp
			local rootPos = cand.rootPos
			local dist = cand.dist

			local head = cache.head
			local topPos = head and Camera:WorldToViewportPoint(head.Position + VEC_HEAD_OFFSET)
				or Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
			local botPos = Camera:WorldToViewportPoint(hrp.Position - VEC_FEET_OFFSET)
			local height = math.clamp(math.abs(topPos.Y - botPos.Y), 4, 900)
			local width = height * 0.55
			local x = rootPos.X - width / 2
			local y = math.min(topPos.Y, botPos.Y)

			if Settings.ShowBox and slot.box and slot.boxOutline then
				slot.box.Position = Vector2.new(x, y)
				slot.box.Size = Vector2.new(width, height)
				slot.box.Color = color
				slot.box.Visible = true

				slot.boxOutline.Position = slot.box.Position
				slot.boxOutline.Size = slot.box.Size
				slot.boxOutline.Visible = true
			else
				if slot.box then slot.box.Visible = false end
				if slot.boxOutline then slot.boxOutline.Visible = false end
			end

			if Settings.ShowName and slot.name then
				slot.name.Text = model.Name
				slot.name.Position = Vector2.new(rootPos.X, y - 16)
				slot.name.Size = Settings.TextSize
				slot.name.Color = color
				slot.name.Visible = true
			else
				if slot.name then slot.name.Visible = false end
			end

			if Settings.ShowDistance and slot.dist then
				slot.dist.Text = tostring(math.floor(dist + 0.5)) .. "m"
				slot.dist.Position = Vector2.new(rootPos.X, y + height + 2)
				slot.dist.Size = Settings.TextSize
				slot.dist.Color = color
				slot.dist.Visible = true
			else
				if slot.dist then slot.dist.Visible = false end
			end

			if Settings.ShowTracer and slot.tracer then
				local vp = Camera.ViewportSize
				local origin
				if Settings.TracerOrigin == "Center" then
					origin = Vector2.new(vp.X / 2, vp.Y / 2)
				elseif Settings.TracerOrigin == "Mouse" then
					origin = UserInputService:GetMouseLocation()
				elseif Settings.TracerOrigin == "Top" then
					origin = Vector2.new(vp.X / 2, 0)
				else
					origin = Vector2.new(vp.X / 2, vp.Y)
				end
				slot.tracer.From = origin
				slot.tracer.To = Vector2.new(rootPos.X, y + height)
				slot.tracer.Color = color
				slot.tracer.Visible = true
			else
				if slot.tracer then slot.tracer.Visible = false end
			end

			if Settings.ShowSkeleton and slot.skeleton then
				local parts = cache.parts
				local boneList = parts.UpperTorso and R15_BONES or R6_BONES
				for b, pair in ipairs(boneList) do
					local partA = parts[pair[1]]
					local partB = parts[pair[2]]
					local line = slot.skeleton[b]
					if line then
						if partA and partB then
							local a, onA = Camera:WorldToViewportPoint(partA.Position)
							local bPos, onB = Camera:WorldToViewportPoint(partB.Position)
							if (onA and a.Z > 0) or (onB and bPos.Z > 0) then
								line.From = Vector2.new(a.X, a.Y)
								line.To = Vector2.new(bPos.X, bPos.Y)
								line.Color = color
								line.Visible = true
							else
								line.Visible = false
							end
						else
							line.Visible = false
						end
					end
				end
				for b = #boneList + 1, #slot.skeleton do
					if slot.skeleton[b] then slot.skeleton[b].Visible = false end
				end
			else
				if slot.skeleton then
					for _, line in ipairs(slot.skeleton) do
						line.Visible = false
					end
				end
			end
		else
			hideSlot(slot)
		end
	end
end)


local function addThemeItem(inst, prop, role)
	table.insert(ThemeItems, { inst = inst, prop = prop, role = role })
end
local function addCornerItem(inst, radius)
	table.insert(CornerItems, { inst = inst, def = radius })
end

local function scanThemeItems(root)
	table.clear(ThemeItems)
	table.clear(CornerItems)
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("UIStroke") then
			addThemeItem(inst, "Color", "accent")
		elseif inst:IsA("ScrollingFrame") then
			addThemeItem(inst, "ScrollBarImageColor3", "accent")
		elseif inst:IsA("Frame") or inst:IsA("TextButton") then
			if sameColor(inst.BackgroundColor3, RED_BASE) then
				addThemeItem(inst, "BackgroundColor3", "accent")
			elseif sameColor(inst.BackgroundColor3, RED_DEEP_BASE) then
				addThemeItem(inst, "BackgroundColor3", "deep")
			end
		end
		if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
			if sameColor(inst.TextColor3, RED_BASE) then addThemeItem(inst, "TextColor3", "accent") end
		end
		if inst:IsA("UICorner") then addCornerItem(inst, inst.CornerRadius) end
	end
end

local function applyGuiTheme()
	if Settings.RainbowColor then
		RED = Color3.fromHSV(rainbowHue, 1, 1)
		RED_DEEP = Color3.fromHSV(rainbowHue, 0.9, 0.45)
	else
		RED = RED_BASE
		RED_DEEP = RED_DEEP_BASE
	end
	for _, item in ipairs(ThemeItems) do
		if item.inst and item.inst.Parent then
			item.inst[item.prop] = (item.role == "deep") and RED_DEEP or RED
		end
	end
	for _, update in pairs(ToggleUpdaters) do update() end
	local main = ScreenGui:FindFirstChild("MainFrame")
	if main then main.BackgroundTransparency = math.clamp(Settings.UITransparency / 100, 0, 0.9) end
	local radius = Settings.UIRoundedCorners and Settings.UICornerRadius or 0
	for _, c in ipairs(CornerItems) do
		if c.inst and c.inst.Parent then
			if c.def.Scale > 0.5 then
				c.inst.CornerRadius = UDim.new(1, 0)
			else
				c.inst.CornerRadius = UDim.new(0, radius)
			end
		end
	end
end


RunService:BindToRenderStep("AimlockUpdate_PHETAMINE", Enum.RenderPriority.Camera.Value + 1, function(dt)
	-- BindToRenderStep returns no connection, so the Runtime can't disconnect it:
	-- the callback has to fail closed itself, then teardown unbinds it by name.
	if not Runtime.alive then
		currentAimTarget = nil
		currentAimTarget2 = nil
		return
	end
	Camera = Workspace.CurrentCamera
	if not Camera then return end
	if Settings.AimlockEnabled and aimlockKeyHeld then
		local obj, part = getBestAimTarget(currentAimTarget, Settings.AimTargetNPCs, Settings.AimTargetPlayers, Settings.AimlockPart, Settings.AimlockWallCheck, Settings.AimlockMaxDistance, Settings.AimlockFOV, Settings.AimTargetClosest)
		currentAimTarget = obj
		if part then aimAt(part, Settings.AimlockSmoothness, Settings.PredictionFactor, dt) end
	else
		currentAimTarget = nil
	end
	if not Settings.AimlockEnabled and Settings.Aimlock2Enabled and aimlockKeyHeld then
		local obj, part = getBestAimTarget(currentAimTarget2, Settings.AimTargetNPCs, true, Settings.Aimlock2Part, Settings.Aimlock2WallCheck, Settings.Aimlock2MaxDistance, Settings.AimlockFOV, false)
		currentAimTarget2 = obj
		if part then aimAt(part, nil, 0, dt) end
	else
		currentAimTarget2 = nil
	end
end)


local lastGameMouseIcon = nil

local function enforceMouseFree()
	-- Also driven by BindToRenderStep (no connection to disconnect), so it has
	-- to fail closed on its own once the Runtime is down.
	if not Runtime.alive then return end
	if not MainFrame or not MainFrame.Parent or not MainFrame.Visible then return end

	if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end

	if not UserInputService.MouseIconEnabled then
		UserInputService.MouseIconEnabled = true
	end

	pcall(function()
		if UserInputService.OverrideMouseIconBehavior ~= Enum.OverrideMouseIconBehavior.ForceShow then
			UserInputService.OverrideMouseIconBehavior = Enum.OverrideMouseIconBehavior.ForceShow
		end
	end)

	pcall(function()
		local m = LocalPlayer:GetMouse()
		if m then
			if m.Icon == "rbxasset://textures/blank.png" or m.Icon == "rbxassetid://0" then
				m.Icon = ""
			end
		end
		if UserInputService.MouseIcon == "rbxasset://textures/blank.png" or UserInputService.MouseIcon == "rbxassetid://0" then
			UserInputService.MouseIcon = ""
		end
	end)
end

local function setGuiVisible(v)
	MainFrame.Visible = v
	if ModalHelper then
		ModalHelper.Visible = v
		ModalHelper.Modal = v
	end

	if v then
		pcall(function()
			local m = LocalPlayer:GetMouse()
			if m and m.Icon ~= "" and m.Icon ~= "rbxasset://textures/ArrowCursor.png" and m.Icon ~= "rbxasset://textures/Cursors/Gamepad/Pointer.png" then
				lastGameMouseIcon = m.Icon
				m.Icon = ""
			end
		end)
		enforceMouseFree()
	else
		pcall(function()
			UserInputService.OverrideMouseIconBehavior = Enum.OverrideMouseIconBehavior.None
			if lastGameMouseIcon then
				local m = LocalPlayer:GetMouse()
				if m then m.Icon = lastGameMouseIcon end
				lastGameMouseIcon = nil
			end
		end)
		if Settings.AutoSave then SaveConfiguration() end
	end
end
CloseBtn.MouseButton1Click:Connect(function() setGuiVisible(false) end)

-- Keep the cursor available and visible while the menu is open across all render/physics stages.
RunService:BindToRenderStep("PHETAMINE_MouseFree_Camera", Enum.RenderPriority.Camera.Value + 1, enforceMouseFree)
RunService:BindToRenderStep("PHETAMINE_MouseFree_Last", Enum.RenderPriority.Last.Value + 100, enforceMouseFree)
Runtime:Connect(RunService.Heartbeat, enforceMouseFree)
Runtime:Connect(RunService.RenderStepped, enforceMouseFree)
Runtime:Connect(RunService.Stepped, enforceMouseFree)

Runtime:Connect(UserInputService.InputBegan, function(input, gpe)
	if not Runtime.alive or not MainFrame or not MainFrame.Parent then return end
	if MainFrame.Visible and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseMovement) then
		enforceMouseFree()
	end
	if gpe then return end
	if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Settings.ToggleKey then
		if Settings.ToggleKeyMode == "Hold" then
			setGuiVisible(true)
		else
			setGuiVisible(not MainFrame.Visible)
		end
	end
end)

Runtime:Connect(UserInputService.InputChanged, function(input)
	if not Runtime.alive or not MainFrame or not MainFrame.Parent then return end
	if MainFrame.Visible and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2) then
		enforceMouseFree()
	end
end)

Runtime:Connect(UserInputService.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Settings.ToggleKey and Settings.ToggleKeyMode == "Hold" then
		setGuiVisible(false)
	end
end)

local CONFIG_FOLDER = "PHETAMINE_STALKER_Configs"
if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then pcall(function() makefolder(CONFIG_FOLDER) end) end

local function encodeSetting(v)
	if typeof(v) == "EnumItem" and v.EnumType == Enum.KeyCode then
		return { __type = "KeyCode", value = v.Name }
	elseif typeof(v) == "Color3" then
		return { __type = "Color3", R = math.floor(v.R * 255 + 0.5), G = math.floor(v.G * 255 + 0.5), B = math.floor(v.B * 255 + 0.5) }
	end
	return v
end

local function decodeSetting(v, old)
	if type(v) == "table" and v.__type == "KeyCode" then
		return Enum.KeyCode[v.value] or old
	elseif type(v) == "table" and v.__type == "Color3" then
		return Color3.fromRGB(v.R or 170, v.G or 25, v.B or 30)
	end
	return v
end

local function SaveConfiguration()
	if not writefile then return warn("[Config] writefile not supported") end
	local data = {}
	for k, v in pairs(Settings) do data[k] = encodeSetting(v) end
	local path = CONFIG_FOLDER .. "/" .. (Settings.ConfigName or "default") .. ".json"
	pcall(function() writefile(path, HttpService:JSONEncode(data)) end)
	warn("[Config] saved " .. path)
end

local function LoadConfiguration()
	if not (readfile and isfile) then return end
	local path = CONFIG_FOLDER .. "/" .. (Settings.ConfigName or "default") .. ".json"
	if not isfile(path) then return end
	local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if ok and type(decoded) == "table" then
		for k, v in pairs(decoded) do
			if Settings[k] ~= nil then Settings[k] = decodeSetting(v, Settings[k]) end
		end
		-- Legacy fallback mapping
		if decoded.HitboxPlayers ~= nil and decoded.HitboxNPCs == nil then
			Settings.HitboxNPCs = decoded.HitboxPlayers
		end
		if decoded.AimTargetPlayers ~= nil and decoded.AimTargetNPCs == nil then
			Settings.AimTargetNPCs = decoded.AimTargetPlayers
		end
		-- Legacy configs may contain both flags; keep Aimlock 1 authoritative.
		if Settings.AimlockEnabled and Settings.Aimlock2Enabled then
			Settings.Aimlock2Enabled = false
		end
		applyGuiTheme()
		if Settings.FlyEnabled then task.defer(function() setFly(true) end) end
		if Settings.AutoChamber or Settings.AutoFireMode then task.defer(scanAllSPHWeapons) end
		task.defer(updatePlayerHighlights)
		warn("[Config] loaded " .. path)
	end
end

local function ResetTheme()
	Settings.UITransparency = 0
	Settings.UIRoundedCorners = false
	Settings.UICornerRadius = 0
	Settings.RainbowColor = false
	Settings.Color = Color3.fromRGB(170, 25, 30)
	Settings.PlayerHighlightColor = Color3.fromRGB(0, 170, 255)
	applyGuiTheme()
end


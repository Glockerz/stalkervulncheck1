-- SPH Weapons Manager (Auto Chamber & FireMode 2)
----------------------------------------------------
-- Exposed to the GUI / config / heartbeat; internals live in the do-block.
local scanAllSPHWeapons
do
	-- Weak-keyed: Tools get garbage collected after being destroyed/removed.
	-- record = { conns = {RBXScriptConnection...}, watched = {[Instance]=true} }
	local TrackedSPHWeapons = setmetatable({}, { __mode = "k" })

	-- Return EVERY descendant of the tool named <name>. SPH kits ship a
	-- template value inside the SPH_Weapons Configuration but often mutate a
	-- separate runtime copy elsewhere in the tool; forcing only the first
	-- match would leave the value the gun actually reads untouched.
	local function valuesNamed(tool, name)
		local out = {}
		local ok, descs = pcall(function() return tool:GetDescendants() end)
		if not ok or not descs then return out end
		for _, v in ipairs(descs) do
			if v.Name == name then table.insert(out, v) end
		end
		return out
	end

	-- Force every Chambered -> true and every FireMode -> configured value
	-- across the whole tool. Called on change, on new guns, and every frame.
	local function enforceList(vals)
		if Settings.AutoChamber then
			for _, v in ipairs(vals.chambered) do
				local ok, isBool = pcall(function() return v:IsA("BoolValue") end)
				if ok and isBool and v.Parent and v.Value ~= true then
					pcall(function() v.Value = true end)
				end
			end
		end
		if Settings.AutoFireMode then
			local desired = tonumber(Settings.FireModeValue) or 2
			for _, v in ipairs(vals.fireMode) do
				local ok, isNum = pcall(function() return v:IsA("IntValue") or v:IsA("NumberValue") end)
				if ok and isNum and v.Parent and v.Value ~= desired then
					pcall(function() v.Value = desired end)
				end
			end
		end
	end

	local function enforceTool(tool)
		if not tool or not tool.Parent then return end
		if not Settings.AutoChamber and not Settings.AutoFireMode then return end
		enforceList({ chambered = valuesNamed(tool, "Chambered"), fireMode = valuesNamed(tool, "FireMode") })
	end

	local function untrack(tool)
		local record = TrackedSPHWeapons[tool]
		if not record then return end
		for _, c in ipairs(record.conns) do
			pcall(function() c:Disconnect() end)
		end
		TrackedSPHWeapons[tool] = nil
	end

	local function watchValue(tool, value)
		local conn
		conn = value:GetPropertyChangedSignal("Value"):Connect(function()
			-- Re-assert next step so the gun's own write has settled.
			task.defer(function()
				if conn.Connected and value.Parent then enforceTool(tool) end
			end)
		end)
		return conn
	end

	-- Wire a change watcher onto every Chambered/FireMode value in the tool
	-- that we aren't already watching (values appear/replace over time), and
	-- cache the live value instances so the per-frame loop allocates nothing.
	local function refreshWatchers(tool)
		local record = TrackedSPHWeapons[tool]
		if not record then return end
		for _, v in ipairs(valuesNamed(tool, "Chambered")) do
			if not record.watched[v] then
				record.watched[v] = true
				table.insert(record.conns, watchValue(tool, v))
				if v.Parent then table.insert(record.vals.chambered, v) end
			end
		end
		for _, v in ipairs(valuesNamed(tool, "FireMode")) do
			if not record.watched[v] then
				record.watched[v] = true
				table.insert(record.conns, watchValue(tool, v))
				if v.Parent then table.insert(record.vals.fireMode, v) end
			end
		end
	end

	local function trackSPHWeapon(tool)
		if not tool or not tool:IsA("Tool") then return end

		-- A tool with a "SPH_Weapons" Configuration anywhere in it is an SPH gun.
		local ok, sphConfig = pcall(function() return tool:FindFirstChild("SPH_Weapons", true) end)
		if not ok or not sphConfig then return end

		local record = TrackedSPHWeapons[tool]
		if not record then
			record = {
				conns = {},
				watched = setmetatable({}, { __mode = "k" }),
				vals = { chambered = {}, fireMode = {} },
			}
			TrackedSPHWeapons[tool] = record

			-- Values/configuration may replicate or be recreated after the Tool.
			table.insert(record.conns, tool.DescendantAdded:Connect(function(child)
				if child.Name == "SPH_Weapons" or child.Name == "Chambered" or child.Name == "FireMode" then
					task.defer(function()
						if tool.Parent then
							refreshWatchers(tool)
							enforceTool(tool)
						end
					end)
				end
			end))

			table.insert(record.conns, tool.AncestryChanged:Connect(function(_, parent)
				if not parent then untrack(tool) end
			end))
		end

		refreshWatchers(tool)
		enforceTool(tool)
	end

	local function hookWeaponContainer(container)
		if not container then return end
		container.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then
				-- Values often replicate a frame after the Tool itself.
				task.defer(function() trackSPHWeapon(child) end)
				task.delay(0.5, function()
					if child.Parent then trackSPHWeapon(child) end
				end)
			end
		end)
		container.DescendantAdded:Connect(function(desc)
			if desc.Name == "SPH_Weapons" then
				local tool = desc:FindFirstAncestorWhichIsA("Tool")
				if tool then task.defer(function() trackSPHWeapon(tool) end) end
			end
		end)
	end

	scanAllSPHWeapons = function()
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		if backpack then
			for _, child in ipairs(backpack:GetChildren()) do
				if child:IsA("Tool") then trackSPHWeapon(child) end
			end
		end
		local char = LocalPlayer.Character
		if char then
			for _, child in ipairs(char:GetChildren()) do
				if child:IsA("Tool") then trackSPHWeapon(child) end
			end
		end
	end

	-- Per-frame enforcement: when the mag empties the gun flips Chambered to
	-- false; re-asserting every Heartbeat means it is true again before the
	-- next frame's fire/reload logic can observe the false. Uses the cached
	-- value lists so it allocates nothing. Also cleans up tools removed
	-- without an AncestryChanged signal.
	Runtime:Connect(RunService.Heartbeat, function()
		if not Settings.AutoChamber and not Settings.AutoFireMode then return end
		for tool, record in pairs(TrackedSPHWeapons) do
			if tool.Parent then
				enforceList(record.vals)
			else
				untrack(tool)
			end
		end
	end)

	task.spawn(function()
		local backpack = LocalPlayer:WaitForChild("Backpack", 10)
		if backpack then hookWeaponContainer(backpack) end
		if LocalPlayer.Character then hookWeaponContainer(LocalPlayer.Character) end
		Runtime:Connect(LocalPlayer.CharacterAdded, function(char)
			hookWeaponContainer(char)
			task.wait(0.5)
			scanAllSPHWeapons()
		end)
		scanAllSPHWeapons()
	end)
end


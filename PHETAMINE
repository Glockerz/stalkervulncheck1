-- Feature cleanup
----------------------------------------------------
Runtime:OnTeardown(function()
	-- Switch the features off first; the loops, the fly rig and the lighting
	-- enforcer all read these, so nothing can re-apply itself halfway through
	-- the teardown.
	Settings.Enabled = false
	Settings.HighlightPlayers = false
	Settings.HighlightNPCs = false
	Settings.AimlockEnabled = false
	Settings.Aimlock2Enabled = false
	Settings.FlyEnabled = false
	Settings.WalkSpeedEnabled = false
	Settings.JumpPowerEnabled = false
	Settings.InfiniteJumpEnabled = false
	Settings.HitboxEnabled = false
	Settings.RemoveFallDamage = false
	aimlockKeyHeld = false
	currentAimTarget = nil
	currentAimTarget2 = nil

	-- The aim lock and the mouse-free enforcers run on BindToRenderStep, which
	-- hands back no connection for the Runtime to disconnect: unbind by name.
	pcall(function() RunService:UnbindFromRenderStep("AimlockUpdate_PHETAMINE") end)
	pcall(function() RunService:UnbindFromRenderStep("PHETAMINE_MouseFree_Camera") end)
	pcall(function() RunService:UnbindFromRenderStep("PHETAMINE_MouseFree_Last") end)

	setNoClip(false)
	cleanupFlyForces()

	-- Drawings: hide the whole ESP pool, then drop the FOV circle.
	hideAllSlots()
	for _, slot in ipairs(ESPPool) do
		for key, drawing in pairs(slot) do
			if key == "skeleton" then
				for _, line in ipairs(drawing) do removeDrawing(line) end
			else
				removeDrawing(drawing)
			end
		end
	end
	removeDrawing(fovCircle)

	-- Chams: players first, then the hostile-NPC highlight folder (the
	-- updater prunes every highlight now that Settings.Enabled is false).
	for _, plr in ipairs(Players:GetPlayers()) do
		destroyPlayerHighlight(plr)
	end
	for plr in pairs(PlayerHighlights) do
		destroyPlayerHighlight(plr)
	end
	for plr, cache in pairs(PlayerCharCache) do
		disconnectPlayerCache(cache)
		PlayerCharCache[plr] = nil
	end
	pcall(updateNPCHighlights)

	-- NPC tracking: per-model DescendantAdded/Removing/Ancestry connections are
	-- owned by the caches (they are re-made whenever a model respawns, so they
	-- are not Runtime registrations); drop them here instead.
	for i = #HostileNPCList, 1, -1 do
		untrackNPC(HostileNPCList[i])
	end
	table.clear(HostileNPCList)
	disconnectHostileState()

	for part, rec in pairs(HitboxRecords) do
		restoreHitboxPart(part, rec)
	end
	table.clear(HitboxRecords)

	setFullBright(false)
end)


-- Lifecycle cleanup only: no client authorization checks or kicks.
local Runtime = { alive = true, connections = {}, teardown = {} }
function Runtime:Stop()
	if not self.alive then return end
	self.alive = false
	for _, connection in ipairs(self.connections) do
		pcall(function() connection:Disconnect() end)
	end
	table.clear(self.connections)
	for _, callback in ipairs(self.teardown) do pcall(callback) end
	table.clear(self.teardown)
end
function Runtime:Connect(signal, callback)
	local connection = signal:Connect(function(...)
		if self.alive then callback(...) end
	end)
	table.insert(self.connections, connection)
	return connection
end
function Runtime:OnTeardown(callback)
	table.insert(self.teardown, callback)
end

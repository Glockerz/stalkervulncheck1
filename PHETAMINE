-- Player Highlighting (Chams)
----------------------------------------------------
local PlayerHighlights = {}
local PlayerCharCache = {}

local function disconnectPlayerCache(cache)
	if not cache then return end
	if cache.descAdded then pcall(function() cache.descAdded:Disconnect() end); cache.descAdded = nil end
	if cache.descRemoving then pcall(function() cache.descRemoving:Disconnect() end); cache.descRemoving = nil end
	if cache.charConn then pcall(function() cache.charConn:Disconnect() end); cache.charConn = nil end
end

local function rebuildPlayerCharCache(cache, char)
	cache.char = char
	cache.hrp = nil
	cache.head = nil
	cache.hum = nil
	cache.parts = cache.parts or {}
	table.clear(cache.parts)

	if not char then return end
	for _, inst in ipairs(char:GetDescendants()) do
		if inst:IsA("BasePart") then
			cache.parts[inst.Name] = inst
			if inst.Name == "HumanoidRootPart" then cache.hrp = inst end
			if inst.Name == "Head" then cache.head = inst end
		elseif inst:IsA("Humanoid") then
			cache.hum = inst
		end
	end
	cache.hrp = cache.hrp or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
	cache.head = cache.head or char:FindFirstChild("Head")
	cache.hum = cache.hum or char:FindFirstChildWhichIsA("Humanoid")
end

local function cachePlayer(plr, char)
	local cache = PlayerCharCache[plr]
	if not cache then
		cache = { parts = {} }
		PlayerCharCache[plr] = cache
	else
		if cache.descAdded then pcall(function() cache.descAdded:Disconnect() end); cache.descAdded = nil end
		if cache.descRemoving then pcall(function() cache.descRemoving:Disconnect() end); cache.descRemoving = nil end
	end

	rebuildPlayerCharCache(cache, char)
	if char then
		cache.descAdded = char.DescendantAdded:Connect(function(inst)
			if inst:IsA("BasePart") then
				cache.parts[inst.Name] = inst
				if inst.Name == "HumanoidRootPart" then cache.hrp = inst end
				if inst.Name == "Head" then cache.head = inst end
			elseif inst:IsA("Humanoid") then
				cache.hum = inst
			end
		end)
		cache.descRemoving = char.DescendantRemoving:Connect(function(inst)
			if inst:IsA("BasePart") and cache.parts[inst.Name] == inst then
				cache.parts[inst.Name] = nil
				if cache.hrp == inst then cache.hrp = nil end
				if cache.head == inst then cache.head = nil end
			elseif cache.hum == inst then
				cache.hum = nil
			end
		end)
	end
	return cache
end

local function getPlayerCache(plr)
	local cache = PlayerCharCache[plr]
	if not cache or cache.char ~= plr.Character then
		cache = cachePlayer(plr, plr.Character)
	end
	return cache
end

local function isPlayerAlive(cache)
	local hum = cache and cache.hum
	return cache and cache.hrp and hum and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead
end

local function createPlayerHighlight(plr)
	if PlayerHighlights[plr] then return PlayerHighlights[plr] end
	local hl = Instance.new("Highlight")
	hl.Name = "PHETAMINE_PlayerHL_" .. plr.Name
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.FillColor = Settings.PlayerHighlightColor
	hl.OutlineColor = Color3.fromRGB(255, 255, 255)
	hl.FillTransparency = Settings.PlayerHighlightFillTransparency
	hl.OutlineTransparency = Settings.PlayerHighlightOutlineTransparency
	hl.Enabled = false
	hl.Parent = Camera

	PlayerHighlights[plr] = hl
	return hl
end

local function destroyPlayerHighlight(plr)
	local hl = PlayerHighlights[plr]
	if hl then
		pcall(function() hl:Destroy() end)
		PlayerHighlights[plr] = nil
	end
	disconnectPlayerCache(PlayerCharCache[plr])
	PlayerCharCache[plr] = nil
end

for _, plr in ipairs(Players:GetPlayers()) do
	if plr ~= LocalPlayer then
		local cache = cachePlayer(plr, plr.Character)
		if cache.charConn then cache.charConn:Disconnect() end
		cache.charConn = plr.CharacterAdded:Connect(function(char)
			cachePlayer(plr, char)
		end)
	end
end

-- Long-lived signals are owned by the runtime for cleanup.
Runtime:Connect(Players.PlayerAdded, function(plr)
	if plr ~= LocalPlayer then
		local cache = cachePlayer(plr, plr.Character)
		if cache.charConn then cache.charConn:Disconnect() end
		cache.charConn = plr.CharacterAdded:Connect(function(char)
			cachePlayer(plr, char)
		end)
	end
end)

Runtime:Connect(Players.PlayerRemoving, destroyPlayerHighlight)

local function updatePlayerHighlights()
	local active = Settings.HighlightPlayers
	local localChar = LocalPlayer.Character
	local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
	local localPos = localHrp and localHrp.Position or (Camera and Camera.CFrame.Position) or ZERO3
	local hlColor = Settings.RainbowColor and currentColor() or Settings.PlayerHighlightColor

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local hl = createPlayerHighlight(plr)
			local char = plr.Character
			local cache = getPlayerCache(plr)
			local alive = isPlayerAlive(cache)
			local show = active and alive

			if show and Settings.PlayerTeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
				show = false
			end

			if show and Settings.MaxDistance > 0 and localPos and cache.hrp then
				local dist = (localPos - cache.hrp.Position).Magnitude
				if dist > Settings.MaxDistance then
					show = false
				end
			end

			if show and char then
				hl.Adornee = char
				hl.FillColor = hlColor
				hl.OutlineColor = Color3.fromRGB(255, 255, 255)
				hl.FillTransparency = Settings.PlayerHighlightFillTransparency
				hl.OutlineTransparency = Settings.PlayerHighlightOutlineTransparency
				hl.Enabled = true
			else
				hl.Enabled = false
				hl.Adornee = nil
			end
		end
	end
end


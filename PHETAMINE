local HitboxRecords = setmetatable({}, { __mode = "k" })

local function restoreHitboxPart(part, rec)
	if not part or not rec then return end
	if part.Parent then
		pcall(function()
			part.Size = rec.Size
			part.Transparency = rec.Transparency
			part.CanCollide = rec.CanCollide
			part.CanQuery = rec.CanQuery
		end)
	end
	HitboxRecords[part] = nil
end

local function markHitboxPart(part)
	if not part or not part.Parent then return end
	if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character) then return end

	local rec = HitboxRecords[part]
	if not rec then
		rec = {
			Size = part.Size,
			Transparency = part.Transparency,
			CanCollide = part.CanCollide,
			CanQuery = part.CanQuery,
			Needed = false,
		}
		HitboxRecords[part] = rec
	end

	rec.Needed = true
	local size = math.max(1, tonumber(Settings.HitboxSize) or 8)
	pcall(function()
		part.Size = Vector3.new(size, size, size)
		part.Transparency = math.clamp(tonumber(Settings.HitboxTransparency) or 0.65, 0, 1)
		part.CanCollide = false
		part.CanQuery = true
	end)
end

local function markNPCHitboxes()
	if not Settings.HitboxNPCs then return end
	for _, model in ipairs(HostileNPCList) do
		local cache = HostileNPCCache[model]
		if cache and isAlive(cache, model) and cache.hrp then
			markHitboxPart(cache.hrp)
		end
	end
end

local function markPlayerHitboxes()
	if not Settings.HitboxPlayers then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local cache = getPlayerCache(plr)
			if cache and isPlayerAlive(cache) and cache.hrp then
				markHitboxPart(cache.hrp)
			end
		end
	end
end

local hitboxAccum = 0
local folderTrackAccum = 0
local sphWatchAccum = 0

Runtime:Connect(RunService.Heartbeat, function(dt)
	folderTrackAccum = folderTrackAccum + dt
	if folderTrackAccum >= 0.75 then
		folderTrackAccum = 0
		updateHostileTracking()
	end

	sphWatchAccum = sphWatchAccum + dt
	if sphWatchAccum >= 0.15 then
		sphWatchAccum = 0
		if Settings.AutoChamber or Settings.AutoFireMode then
			scanAllSPHWeapons()
		end
	end

	hitboxAccum = hitboxAccum + dt
	if hitboxAccum < 0.25 then return end
	hitboxAccum = 0

	for _, rec in pairs(HitboxRecords) do
		rec.Needed = false
	end

	if Settings.HitboxEnabled then
		markNPCHitboxes()
		markPlayerHitboxes()
	end

	for part, rec in pairs(HitboxRecords) do
		if not part or not part.Parent or not Settings.HitboxEnabled or not rec.Needed then
			restoreHitboxPart(part, rec)
		end
	end
end)

